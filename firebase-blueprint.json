{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user roles and permission status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "builder", "user"] },
        "hasAccess": { "type": "boolean" },
        "totalFilesGenerated": { "type": "number" },
        "workLimit": { "type": "number" },
        "credits": { "type": "number", "description": "Current available user credits" },
        "creditsUsed": { "type": "number", "description": "Cumulative credits spent on processing" },
        "lastDailyBonusClaim": { "type": "number", "description": "Timestamp ms of last daily bonus claim" },
        "claimedPromoCodes": { "type": "array", "items": { "type": "string" } },
        "transactions": { "type": "array" },
        "plan": { "type": "string", "enum": ["free", "starter", "pro", "unlimited"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "Review": {
      "title": "Stock Contributor Review",
      "description": "User reviews and testimonials for Melo stock metadata editor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "badge": { "type": "string" },
        "quote": { "type": "string" },
        "rating": { "type": "number" },
        "stats": { "type": "string" },
        "initials": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "role", "quote", "rating", "createdAt"]
    },
    "MuseAiConfig": {
      "title": "Muse AI System Configuration",
      "description": "Non-secret Admin routing configuration for the Muse AI primary execution engine.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "connected": { "type": "boolean" },
        "accountName": { "type": "string", "maxLength": 120 },
        "accountEmail": { "type": "string", "maxLength": 160 },
        "model": { "type": "string", "maxLength": 120 },
        "baseUrl": { "type": "string", "maxLength": 240 },
        "fallbackToGemini": { "type": "boolean" },
        "requestIntervalMs": { "type": "number" },
        "customSystemDirective": { "type": "string", "maxLength": 2000 },
        "keyHint": { "type": "string", "maxLength": 40 },
        "updatedBy": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["enabled", "model", "baseUrl"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and permission settings."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Contributor reviews and testimonials."
    },
    "/system_config/{configId}": {
      "schema": "MuseAiConfig",
      "description": "System-wide non-secret API integration routing configuration."
    }
  }
}
